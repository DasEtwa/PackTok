+            .unwrap(),
+        ] {
+            let pack = model.pack_vocabularies().map_or(0, |p| p[0].pack_id);
+            let valid = TokenId::new(pack, 97);
+            assert_eq!(model.greedy_generate(&[], 0), Err(ModelError::EmptyContext));
+            assert_eq!(
+                model.greedy_generate(&[valid], usize::MAX),
+                Err(ModelError::LengthOverflow)
+            );
+            assert_eq!(
+                model.greedy_generate(&[valid], MAX_GENERATION_TOKENS),
+                Err(ModelError::GenerationTooLong)
+            );
+            let prompt = vec![valid; MAX_GENERATION_TOKENS];
+            assert_eq!(model.greedy_generate(&prompt, 0).unwrap(), prompt);
+            assert_eq!(
+                model.greedy_generate(&prompt, 1),
+                Err(ModelError::GenerationTooLong)
+            );
+            // Bounds reject unsupported lengths before scanning/copying IDs.
+            let mut excessive = vec![valid; MAX_GENERATION_TOKENS + 1];
+            excessive[0] = TokenId::new(99, 0);
+            assert_eq!(
+                model.greedy_generate(&excessive, 0),
+                Err(ModelError::GenerationTooLong)
+            );
+        }
+    }
