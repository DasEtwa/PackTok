 const MAX_MODEL_BYTES: usize = 64 * 1024 * 1024;
+// Magic, version, kind/reserved, dimensions, seed, pack count, parameter count.
+const MODEL_FIXED_BYTES: usize = 8 + 2 + 1 + 1 + 4 + 4 + 8 + 4 + 8;
+const MODEL_PACK_BYTES: usize = 2 + 4;
+
+#[derive(Debug, Eq, PartialEq)]
+struct SerializedSize {
+    parameter_bytes: usize,
+    total_bytes: usize,
+}
+
+/// Canonical complete version-1 wire size, including every descriptor and field.
+fn serialized_model_size(
+    pack_count: usize,
+    parameter_count: usize,
+) -> Result<SerializedSize, ModelError> {
+    let descriptors = pack_count
+        .checked_mul(MODEL_PACK_BYTES)
+        .ok_or(ModelError::LengthOverflow)?;
+    let parameter_bytes = parameter_count
+        .checked_mul(size_of::<f32>())
+        .ok_or(ModelError::LengthOverflow)?;
+    let total_bytes = MODEL_FIXED_BYTES
+        .checked_add(descriptors)
+        .and_then(|size| size.checked_add(parameter_bytes))
+        .ok_or(ModelError::LengthOverflow)?;
+    if total_bytes > MAX_MODEL_BYTES {
+        return Err(ModelError::ModelTooLarge);
+    }
+    Ok(SerializedSize {
+        parameter_bytes,
+        total_bytes,
+    })
+}
 
