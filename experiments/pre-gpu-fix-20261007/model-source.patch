+    #[test]
+    fn generation_validation_keeps_valid_long_and_zero_continuation_behavior() {
+        let config = ModelConfig {
+            hidden_size: 2,
+            context_length: 2,
+        };
+        for (model, pack, continuation) in [
+            (
+                CausalLm::new_flat(config, 256, 19).unwrap(),
+                0,
+                [113, 15, 180, 113, 15, 180, 113, 15],
+            ),
+            (
+                CausalLm::new_factorized(
+                    config,
+                    vec![PackVocabulary {
+                        pack_id: 7,
+                        token_count: 256,
+                    }],
+                    19,
+                )
+                .unwrap(),
+                7,
+                [112; 8],
+            ),
+        ] {
+            let prompt = [
+                TokenId::new(pack, 97),
+                TokenId::new(pack, 98),
+                TokenId::new(pack, 99),
+            ];
+            assert_eq!(model.greedy_generate(&prompt, 0).unwrap(), prompt);
+            let mut expected = prompt.to_vec();
+            expected.extend(
+                continuation
+                    .into_iter()
+                    .map(|local| TokenId::new(pack, local)),
+            );
+            // Golden IDs captured before the fix; not another generation loop.
+            assert_eq!(model.greedy_generate(&prompt, 8).unwrap(), expected);
+        }
+    }
