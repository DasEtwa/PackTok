+    #[test]
+    fn serialization_constructors_reject_unwritable_boundary_layouts() {
+        let config = ModelConfig {
+            hidden_size: 8,
+            context_length: 6,
+        };
+        assert_eq!(
+            CausalLm::new_flat(config, 986_888, 19),
+            Err(ModelError::ModelTooLarge)
+        );
+        assert_eq!(
+            CausalLm::new_factorized(
+                config,
+                vec![PackVocabulary {
+                    pack_id: 7,
+                    token_count: 986_887,
+                }],
+                19
+            ),
+            Err(ModelError::ModelTooLarge)
+        );
+        let four_packs = |first| {
+            vec![
+                PackVocabulary {
+                    pack_id: 0,
+                    token_count: first,
+                },
+                PackVocabulary {
+                    pack_id: 1,
+                    token_count: 1,
+                },
+                PackVocabulary {
+                    pack_id: 2,
+                    token_count: 1,
+                },
+                PackVocabulary {
+                    pack_id: 3,
+                    token_count: 1,
+                },
+            ]
+        };
+        assert_eq!(
+            CausalLm::new_factorized(config, four_packs(986_882), 19),
+            Err(ModelError::ModelTooLarge)
+        );
+        // The nearest smaller layouts pass the size guard and reach body
+        // validation without allocating ~200 MiB of parameter/Adam state.
+        let bad_body = Err(ModelError::MalformedArtifact(
+            "parameter count does not match dimensions",
+        ));
+        assert_eq!(
+            CausalLm::flat_model(config, 986_887, 19, Some(&[])),
+            bad_body
+        );
+        assert_eq!(
+            CausalLm::factorized_model(config, four_packs(986_881), 19, Some(&[])),
+            bad_body
+        );
+    }
