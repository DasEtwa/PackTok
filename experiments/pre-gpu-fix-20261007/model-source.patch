+    #[test]
+    fn serialization_size_boundary_includes_flat_and_factorized_headers() {
+        // Equivalent boundary calculations avoid allocating several huge models.
+        let flat = serialized_model_size(1, 16_777_204).unwrap();
+        assert_eq!(flat.parameter_bytes, 67_108_816);
+        assert_eq!(flat.total_bytes, MAX_MODEL_BYTES - 2);
+        assert_eq!(
+            serialized_model_size(1, 16_777_205),
+            Err(ModelError::ModelTooLarge)
+        );
+        let factorized = serialized_model_size(4, 16_777_200).unwrap();
+        assert_eq!(factorized.total_bytes, MAX_MODEL_BYTES);
+        assert_eq!(
+            serialized_model_size(4, 16_777_201),
+            Err(ModelError::ModelTooLarge)
+        );
+        for pack_count in 1..=MAX_PACK_COUNT {
+            let header = 40 + 6 * pack_count;
+            let largest = (MAX_MODEL_BYTES - header) / 4;
+            assert_eq!(
+                serialized_model_size(pack_count, largest)
+                    .unwrap()
+                    .total_bytes,
+                header + 4 * largest
+            );
+            assert_eq!(
+                serialized_model_size(pack_count, largest + 1),
+                Err(ModelError::ModelTooLarge)
+            );
+        }
+    }
+
