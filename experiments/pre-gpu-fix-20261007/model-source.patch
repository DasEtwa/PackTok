+    #[test]
+    fn generation_validation_rejects_factorized_pack_and_local_ids() {
+        let model = CausalLm::new_factorized(
+            ModelConfig {
+                hidden_size: 2,
+                context_length: 2,
+            },
+            vec![PackVocabulary {
+                pack_id: 7,
+                token_count: 256,
+            }],
+            19,
+        )
+        .unwrap();
+        let valid = TokenId::new(7, 97);
+        for (invalid, error) in [
+            (TokenId::new(99, 0), ModelError::UnknownPack(99)),
+            (
+                TokenId::new(7, 256),
+                ModelError::InvalidToken {
+                    index: 0,
+                    token: TokenId::new(7, 256),
+                },
+            ),
+        ] {
+            for position in 0..3 {
+                let mut prompt = [valid; 3];
+                prompt[position] = invalid;
+                let expected = match error {
+                    ModelError::InvalidToken { token, .. } => ModelError::InvalidToken {
+                        index: position,
+                        token,
+                    },
+                    ref other => other.clone(),
+                };
+                for count in [0, 1] {
+                    assert_eq!(model.greedy_generate(&prompt, count), Err(expected.clone()));
+                }
+            }
+        }
+    }
